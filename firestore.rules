rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLayout(data) {
      return data.keys().hasAll(['id', 'transforms', 'visibility'])
        && data.id is string
        && data.id.size() <= 128
        && data.transforms is map
        && data.visibility is map;
    }

    // Room layouts synchronized in real-time across devices
    match /room_layouts/{layoutId} {
      allow get, list: if isValidId(layoutId);
      allow create, update: if isValidId(layoutId)
        && isValidLayout(request.resource.data);
      allow delete: if isValidId(layoutId);
    }
  }
}
